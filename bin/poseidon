#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Poseidon en ligne de commande.
 *
 *   poseidon search  <racine> <filtre> [options]   Recherche (sortie façon grep)
 *   poseidon extract <racine> <filtre> --out=fichier.csv [options]
 *   poseidon diff    <fichierA> <fichierB>          Comparaison façon git diff (texte extrait)
 *   poseidon cat     <fichier>                      Texte extrait d'un fichier (PDF, DOCX, XLSX...)
 *   poseidon serve   [--host=127.0.0.1] [--port=8080]
 *   poseidon info
 */

require dirname(__DIR__) . '/bootstrap.php';

use Poseidon\Cli\Application;

exit((new Application(Poseidon\Config::load()))->run($argv));
