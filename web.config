<?xml version="1.0" encoding="UTF-8"?>
<!--
  Poseidon sous IIS : déposer le dossier (ex. C:\inetpub\wwwroot\poseidon) et ouvrir http://serveur/poseidon/
  Aucun module optionnel requis (pas d'URL Rewrite) : l'interface appelle l'API via index.php/… (PATH_INFO).
  Le filtrage de requêtes intégré à IIS interdit l'accès direct aux dossiers internes.
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="var" />
          <add segment="config" />
          <add segment="src" />
          <add segment="bin" />
          <add segment="tests" />
          <add segment="docs" />
          <add segment="samples" />
          <add segment=".git" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".key" allowed="false" />
          <add fileExtension=".sqlite" allowed="false" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
